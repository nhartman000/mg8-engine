# Copy this file to .env and paste ONE API key below. The demo and the
# experiment pick whichever is set (Anthropic first, then OpenAI, then
# Gemini). If you run demo.py with no key configured, it will ask you
# interactively and write .env for you.
#
# .env is git-ignored -- your key never leaves this machine.

# Anthropic (Claude): https://console.anthropic.com/settings/keys
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT): https://platform.openai.com/api-keys
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-4o-mini

# Google (Gemini): https://aistudio.google.com/apikey
#GEMINI_API_KEY=...
#GEMINI_MODEL=gemini-2.5-flash

# Vertex AI (GCP, uses Application Default Credentials):
# gcloud auth application-default login
#GOOGLE_CLOUD_PROJECT=true-artwork-479005-r3
#VERTEX_MODEL=gemini-2.5-flash

# Vertex AI Batch Prediction (no rate limits, GCS-backed):
# uncomment to use instead of streaming vertex:
#NYCH_LLM_PROVIDER=vertex_batch
