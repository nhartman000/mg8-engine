{
  "id": "basic-unit-flow",
  "entry": "load_state",

  "steps": {
    "load_state": {
      "action": "load",
      "target": "state.gst",
      "next": "load_gates"
    },

    "load_gates": {
      "action": "load",
      "target": "gates.g8son",
      "next": "evaluate"
    },

    "evaluate": {
      "action": "execute",
      "target": "gates.g8son",
      "next": "decision"
    },

    "decision": {
      "action": "branch",
      "condition": "result == true",
      "then": "complete",
      "else": "reject"
    },

    "complete": {
      "action": "trace",
      "event": "pass"
    },

    "reject": {
      "action": "trace",
      "event": "fail"
    }
  }
}
